# Copy this template to .env and supply values locally. Never commit .env.
# Use a percent-encoded PostgreSQL connection URL for your own database.
DATABASE_URL=
# Direct or session-pooler URL for scripts/prisma-database.mjs (Prisma migrations).
# Supabase runtime: transaction pooler 6543 with pgbouncer=true and sslmode=require.
# Supabase CLI: session pooler 5432, or direct 5432 where IPv6 is available.
DIRECT_URL=
# Neon direct URL for db:neon:migrate/status; application uses pooled DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Written locally by Neon CLI. Neon Auth is provisioned, not wired into the dashboard.
NEON_BRANCH=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
POSTGRES_USER=iran_today
POSTGRES_PASSWORD=
POSTGRES_DB=iran_today
# Required to access the dashboard, including in local development.
ADMIN_USERNAME=
ADMIN_PASSWORD=
WORKER_ID=foundation-worker
WORKER_HEARTBEAT_MS=15000
# Phase 2/3 ONLY — unused by Phase 1; exact monitoring adapter is still to be selected.
# X_BEARER_TOKEN=
# AI_PROVIDER=
# AI_API_KEY=
# AI_MODEL=
# AI_EMBEDDING_MODEL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Always-on Telegram ingestion/processing worker; see docs/RAILWAY-WORKER.md.
# Set credentials privately as sealed Railway runtime variables.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Restored on restart. Interactive recovery uses npm run telegram:authorize locally.
TELEGRAM_SESSION=
GEMINI_API_KEY=
SHADOW_MODE=true
REQUIRE_APPROVAL=true
AUTO_PUBLISH=false
TELEGRAM_PUBLISH_ENABLED=false
# Railway supplies PORT; never copy dashboard or publisher credentials to this worker.
